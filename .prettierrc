{
  "$schema": "https://json.schemastore.org/prettierrc",
  "endOfLine": "lf",
  "semi": true,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "es5",
  "printWidth": 100,
  "plugins": [
    "@ianvs/prettier-plugin-sort-imports",
    "prettier-plugin-tailwindcss"
  ],
  "importOrder": [
    "<BUILTIN_MODULES>",
    "",
    "^react$",
    "^react-dom$",
    "^next(/.*)?$",
    "",
    "<THIRD_PARTY_MODULES>",
    "",
    "^@core/(.*)$",
    "^@components/(.*)$",
    "^@features/(.*)$",
    "^@hooks/(.*)$",
    "^@lib/(.*)$",
    "^@providers/(.*)$",
    "^@store/(.*)$",
    "^@utils/(.*)$",
    "^@styles/(.*)$",
    "",
    "^[./]",
    "",
    "^(?!.*[.]css$)[./].*$",
    "^.+\\.css$"
  ],
  "importOrderParserPlugins": ["typescript", "jsx", "decorators-legacy"],
  "importOrderTypeScriptVersion": "5.0.0",
  "tailwindStylesheet": "core/styles/globals.css",
  "tailwindFunctions": ["cn", "cva", "clsx"]
}